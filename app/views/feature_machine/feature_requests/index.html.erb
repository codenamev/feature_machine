<% product = FeatureMachine.config.product_name %>
<% roadmap = FeatureMachine.config.host_path(:roadmap_path, self) %>
<% bug_reports = FeatureMachine.config.host_path(:bug_reports_path, self) %>
<% button = "cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 group/button select-none cn-button-size-default" %>
<% content_for :title, "Your feature requests — #{product}" %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="cn-container">
  <%= render "feature_machine/flash" %>
  <header class="cn-page-header">
    <p class="cn-page-header-eyebrow">Roadmap</p>
    <h1 class="cn-page-header-title">Your feature requests</h1>
    <p class="cn-page-header-lede">
      What you've asked for and where each request stands. Only you can see
      this page.<% if roadmap %> What requests turn into is on the <%= link_to "roadmap", roadmap %>.<% end %>
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <a href="<%= new_feature_request_path %>" data-slot="button" data-variant="default" data-size="default"
         class="<%= button %> cn-button-variant-default"><span data-slot="label" class="contents">Request a feature</span></a>
      <% if bug_reports %>
        <a href="<%= bug_reports %>" data-slot="button" data-variant="ghost" data-size="default"
           class="<%= button %> cn-button-variant-ghost"><span data-slot="label" class="contents">Your bug reports</span></a>
      <% end %>
    </div>
  </header>

  <% if @feature_requests.empty? %>
    <div data-slot="empty" class="cn-empty flex w-full min-w-0 flex-1 flex-col items-center justify-center text-center text-balance">
      <div data-slot="empty-header" class="cn-empty-header flex max-w-sm flex-col items-center">
        <div data-slot="empty-icon" data-variant="icon" class="cn-empty-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-empty-media-icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
        </div>
        <h2 data-slot="empty-title" class="cn-empty-title cn-font-heading">No feature requests yet</h2>
        <p data-slot="empty-description" class="cn-empty-description text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary">What would make <%= product %> more useful to you? Ask, and follow it here.</p>
      </div>
    </div>
  <% else %>
    <div class="cn-entry-list" id="feature-requests">
      <%= render partial: "feature_machine/feature_requests/feature_request", collection: @feature_requests %>
    </div>
  <% end %>
</div>
