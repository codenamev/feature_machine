<% config = FeatureMachine.config %>
<% triage = config.host_path(:admin_triage_path, self) %>
<% roadmap = @work_item.on_roadmap? ? config.host_path(:roadmap_path, self, @work_item) : nil %>
<% button = "cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 group/button select-none" %>
<% select = "cn-native-select w-full appearance-none outline-none disabled:pointer-events-none disabled:cursor-not-allowed" %>
<% content_for :title, "#{@work_item.title} — #{config.product_name}" %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>
<% requests = @work_item.feature_requests.includes(:user).oldest_first.to_a %>
<% relations = @work_item.relations.to_a %>
<% similar = @work_item.similar %>

<div class="container">
  <header class="page-header">
    <p class="page-header__eyebrow">Admin · <%= work_kind_label(@work_item) %></p>
    <h1 class="page-header__title"><%= @work_item.title %></h1>
    <p class="mt-3 flex flex-wrap items-center gap-3">
      <%= work_item_status(@work_item) %>
      <span class="text-sm text-muted-foreground">
        <%= pluralize(requests.size, "request") %> from <%= pluralize(requests.map(&:user_id).uniq.size, "person") %> ·
        <%= @work_item.handoff_ready? ? "spec ready for hand-off" : "spec incomplete" %>
      </span>
    </p>
    <%= render config.admin_nav_partial if config.admin_nav_partial? %>

    <% if (pull_request = pull_request_href(@work_item)) %>
      <div class="review-panel" id="review">
        <p class="review-panel__lede">
          <% if @work_item.in_review? %>
            <strong>Waiting on your review.</strong>
          <% end %>
          Pull request
          <%= link_to @work_item.pull_request_number, pull_request, rel: "noopener", target: "_blank" %>
          <span class="text-muted-foreground">github.com/<%= @work_item.pull_request_path %></span>
        </p>
        <% if @work_item.in_review? %>
          <div class="review-panel__actions">
            <%# Plain anchors and buttons on the host's cn-button hooks; the engine ships no components. %>
            <a href="<%= pull_request %>" target="_blank" rel="noopener" data-slot="button" data-variant="outline" data-size="default"
               class="<%= button %> cn-button-size-default cn-button-variant-outline"><span data-slot="label" class="contents">Review on GitHub</span></a>
            <%= button_to "Mark shipped", admin_work_item_path(@work_item), method: :patch,
                  params: { work_item: { status: "shipped" } }, class: "btn btn--primary btn--sm",
                  form: { data: { turbo_confirm: "Mark this shipped? It moves from the roadmap to the changelog, and everyone who asked sees it as live." } } %>
            <%= button_to "Send back", admin_work_item_path(@work_item), method: :patch,
                  params: { work_item: { status: "in_progress" } }, class: "btn btn--secondary btn--sm" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <a href="<%= edit_admin_work_item_path(@work_item) %>" data-slot="button" data-variant="default" data-size="default"
         class="<%= button %> cn-button-size-default cn-button-variant-default"><span data-slot="label" class="contents">Edit</span></a>
      <a href="<%= admin_work_item_path(@work_item, format: :md) %>" data-slot="button" data-variant="outline" data-size="default"
         class="<%= button %> cn-button-size-default cn-button-variant-outline"><span data-slot="label" class="contents">Spec as Markdown</span></a>
      <% if roadmap %>
        <a href="<%= roadmap %>" data-slot="button" data-variant="ghost" data-size="default"
           class="<%= button %> cn-button-size-default cn-button-variant-ghost"><span data-slot="label" class="contents">View on roadmap</span></a>
      <% end %>
    </div>
  </header>

  <section class="spec" aria-label="Specification">
    <% { "Summary" => @work_item.summary, "Problem" => @work_item.problem, "Scope" => @work_item.scope,
         "Acceptance criteria" => @work_item.acceptance_criteria, "Progress" => @work_item.progress_note }.each do |heading, body| %>
      <div class="entry-section">
        <h2 class="entry-section__title"><%= heading %></h2>
        <% if body.present? %>
          <div class="entry-section__content"><%= simple_format(body) %></div>
        <% else %>
          <p class="entry-section__content text-muted-foreground">Not written yet.</p>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="mt-12" aria-labelledby="requests-title">
    <h2 class="entry-section__title" id="requests-title">Requests</h2>
    <% if requests.empty? %>
      <p class="entry-section__content text-muted-foreground">
        No requests attached.<% if triage %> Attach some from <%= link_to "triage", triage %>.<% end %>
      </p>
    <% else %>
      <div class="entry-list">
        <% requests.each do |feature_request| %>
          <%# One request on the host's cn-nr-entry hooks. The requester is named the host's way
              (config.user_label) and never linked: the engine knows no host route. %>
          <article id="<%= dom_id(feature_request) %>" data-slot="nr-entry" data-state="ready"
                   class="cn-nr-entry flex gap-4 py-5 border-b border-border group/entry cn-nr-entry-state-ready">
            <div data-slot="nr-entry-body" class="cn-nr-entry-body order-1 min-w-0 flex-1">
              <div class="cn-nr-entry-title-row flex flex-wrap items-baseline gap-3">
                <h3 data-slot="nr-entry-title" class="cn-nr-entry-title"><%= feature_request.title %></h3>
              </div>
              <div data-slot="nr-entry-meta" class="cn-nr-entry-meta mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
                <span class="cn-nr-entry-meta-item"><%= config.label_for(feature_request.user) %></span>
                <span class="cn-nr-entry-meta-sep" aria-hidden="true">&middot;</span>
                <span class="cn-nr-entry-meta-item">filed <%= feature_request.created_at.strftime("%b %-d, %Y") %></span>
              </div>
              <% if feature_request.description.present? %>
                <p data-slot="nr-entry-summary" class="cn-nr-entry-summary mt-2 line-clamp-2"><%= feature_request.description %></p>
              <% end %>
            </div>
            <div data-slot="nr-entry-actions" class="cn-nr-entry-actions order-3 mt-1 flex flex-none items-start gap-1">
              <%= button_to "Detach", admin_feature_request_path(feature_request), method: :patch,
                    params: { feature_request: { work_item_id: "" } }, class: "btn btn--quiet btn--sm" %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="mt-12" aria-labelledby="relations-title">
    <h2 class="entry-section__title" id="relations-title">Related work</h2>
    <% if relations.any? %>
      <ul class="relation-list" id="relations">
        <% relations.each do |relation| %>
          <% other = relation.counterpart_of(@work_item) %>
          <li class="relation-list__item">
            <span><%= relation.label_for(@work_item) %> <%= link_to other.title, admin_work_item_path(other) %> <%= work_item_status(other) %></span>
            <%= button_to "Remove", admin_work_item_relation_path(@work_item, relation), method: :delete, class: "btn btn--quiet btn--sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if similar.any? %>
      <p class="entry-section__content mt-4">Looks related, not linked yet:</p>
      <ul class="relation-list" id="similar-work-items">
        <% similar.each do |other| %>
          <li class="relation-list__item">
            <span><%= link_to other.title, admin_work_item_path(other) %> <%= work_item_status(other) %></span>
            <%= button_to "Link as related", admin_work_item_relations_path(@work_item),
                  params: { work_item_relation: { to_work_item_id: other.id, kind: "related" } }, class: "btn btn--secondary btn--sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% others = ::FeatureMachine::WorkItem.where.not(id: @work_item.id).order(:title) %>
    <% if others.any? %>
      <%= form_with url: admin_work_item_relations_path(@work_item), scope: :work_item_relation, class: "relation-form" do %>
        <span>This item</span>
        <%# Real <select>s on the host's cn-native-select hooks: platform picker and submission stay native. %>
        <span data-slot="native-select-wrapper" data-size="sm" class="relative w-fit has-[select:disabled]:opacity-50 group/native-select">
          <%= select_tag "work_item_relation[kind]", options_for_select(work_item_relation_options),
                aria: { label: "Relation" }, data: { slot: "native-select", size: "sm" }, class: select %>
        </span>
        <span data-slot="native-select-wrapper" data-size="sm" class="relative w-fit has-[select:disabled]:opacity-50 group/native-select">
          <%= select_tag "work_item_relation[to_work_item_id]", options_for_select(others.map { |other| [ other.title, other.id ] }),
                aria: { label: "Other work item" }, data: { slot: "native-select", size: "sm" }, class: select %>
        </span>
        <button type="submit" class="btn btn--secondary btn--sm">Link</button>
      <% end %>
    <% elsif relations.empty? %>
      <p class="entry-section__content text-muted-foreground">No other work items to link to yet.</p>
    <% end %>
  </section>

  <% if @work_item.draft? %>
    <div class="mt-12">
      <%= button_to "Delete this draft", admin_work_item_path(@work_item), method: :delete, class: "btn btn--danger btn--sm",
            form: { data: { turbo_confirm: "Delete this draft? Its requests go back to triage." } } %>
    </div>
  <% end %>
</div>
