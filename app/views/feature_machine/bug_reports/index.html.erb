<% product = FeatureMachine.config.product_name %>
<% roadmap = FeatureMachine.config.host_path(:roadmap_path, self) %>
<% button = "cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 group/button select-none cn-button-size-default" %>
<% content_for :title, "Your bug reports — #{product}" %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="cn-container">
  <%= render "feature_machine/flash" %>
  <header class="cn-page-header">
    <p class="cn-page-header-eyebrow">Roadmap</p>
    <h1 class="cn-page-header-title">Your bug reports</h1>
    <p class="cn-page-header-lede">
      What you've reported and where each one stands. Only you can see this
      page.<% if roadmap %> Fixes also show up on the <%= link_to "roadmap", roadmap %>.<% end %>
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <a href="<%= new_bug_report_path %>" data-slot="button" data-variant="default" data-size="default"
         class="<%= button %> cn-button-variant-default"><span data-slot="label" class="contents">Report a bug</span></a>
      <a href="<%= feature_requests_path %>" data-slot="button" data-variant="ghost" data-size="default"
         class="<%= button %> cn-button-variant-ghost"><span data-slot="label" class="contents">Your feature requests</span></a>
    </div>
  </header>

  <% if @bug_reports.empty? %>
    <div data-slot="empty" class="cn-empty flex w-full min-w-0 flex-1 flex-col items-center justify-center text-center text-balance">
      <div data-slot="empty-header" class="cn-empty-header flex max-w-sm flex-col items-center">
        <h2 data-slot="empty-title" class="cn-empty-title cn-font-heading">No bug reports yet</h2>
        <p data-slot="empty-description" class="cn-empty-description text-muted-foreground">If something isn't working the way it should, tell us and follow the fix here.</p>
      </div>
    </div>
  <% else %>
    <div class="cn-entry-list" id="bug-reports">
      <%= render partial: "feature_machine/feature_requests/feature_request", collection: @bug_reports %>
    </div>
  <% end %>
</div>
